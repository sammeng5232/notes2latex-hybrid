# Copy to .env and adjust. All settings can also be edited in the web UI Settings page.
# Every variable takes the N2LH_ prefix.

# Engine: heuristic | vlm | hybrid
# Default here: the opencode-configured provider (SCRP proxy), whose
# qwen3.6-35b-1 model supports Vision + Text + Reasoning (verified by probe).
N2LH_ENGINE=vlm
N2LH_VLM_BASE_URL=https://scrp-chat.econ.cuhk.edu.hk/api
N2LH_VLM_API_KEY=
# Vision + Text + Reasoning (default); qwen3.6-35b-2 is the alternate.
# glm-5.3 / glm-5.2 on this proxy are TEXT-ONLY (reject images).
N2LH_VLM_MODEL=qwen3.6-35b-1
# Route VLM calls through the system HTTPS_PROXY (e.g. Clash Verge). Leave false:
# a global proxy drops the TLS handshake to this campus endpoint
# (UNEXPECTED_EOF_WHILE_READING). The app connects directly by default.
N2LH_VLM_USE_PROXY=false

# TrOCR adapter: path to a fine-tuned image->LaTeX checkpoint (Math2LaTeX-style training)
N2LH_TROCR_MODEL_DIR=

# Pipeline knobs
N2LH_DPI=300
N2LH_LATEX_ENGINE=pdflatex
N2LH_COMPILE_TIMEOUT=60
N2LH_MAX_RETRIES=3
N2LH_CONTEXT_LINES=40
N2LH_ESCALATE_TO_VLM=true
# Base text size of the generated document: 10, 11 or 12.
N2LH_DOC_FONT_PT=11
# Copy every finished document (.tex, .pdf and its figures/ folder) here, named
# after the uploaded file. Empty = keep results in the app only.
N2LH_OUTPUT_DIR=
N2LH_DATA_DIR=data
