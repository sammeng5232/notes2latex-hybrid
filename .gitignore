__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Secrets and local state. The dev data/ holds settings.json (API key), job
# history and the notes that were converted: never commit it. Anchored to the
# root, or it would also swallow tests/data/, which holds test fixtures.
.env
/data/
/out/

# PyInstaller intermediates, but the build scripts and the shipped exe are part
# of the project: build/work/ is generated, build/*.spec and build/*.ps1 are not.
build/work/
build/lib/
build/bdist.*/
build/icon.ico
dist/*
!dist/notes2latex-hybrid.exe

# LaTeX aux files (strict cleanup policy)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Added 2026-09-28 after a `git add .` audit: secrets, local data and build output
# Local state wherever it lands: GUI-from-source writes .n2lh-dev/ (settings.json = API key,
# jobs, logs); `serve --data-dir data` is cwd-relative.
.n2lh-dev/
**/settings.json
**/jobs/
logs/
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
.env.*
*.env
!.env.example
*.cer
*.crt
pfx_password*
# PyInstaller work/dist subfolders under build/ (tracked build files are top-level only)
build/*/
# User inputs/outputs dropped at the root
/*.pdf
/*.png
/*.jpg
/*.jpeg
.coverage
htmlcov/
.idea/
.vscode/
Thumbs.db
desktop.ini
*.part
*.tmp
